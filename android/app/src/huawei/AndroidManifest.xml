<?xml version="1.0" encoding="utf-8"?>
<!--
  Huawei (AppGallery) flavor manifest overlay.
  Keeps REQUEST_INSTALL_PACKAGES so the Huawei build can self-update
  by downloading and installing the latest APK directly.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
