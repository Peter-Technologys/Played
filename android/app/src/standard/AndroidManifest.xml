<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard (Google Play) flavor manifest overlay.
  Removes REQUEST_INSTALL_PACKAGES so the Play build does NOT have
  self-update install capability — the developer handles updates via
  the Play Store instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Remove self-install permission for Play Store compliance -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
