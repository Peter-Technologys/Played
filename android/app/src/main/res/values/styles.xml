
<resources>
    
    <!-- tools:keep in res/raw/keep.xml prevents the resource shrinker from
         renaming launch_background to an obfuscated filename (e.g. aT.xml),
         which caused a Resources$NotFoundException crash on startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Branded splash: navy + cyan glow + app icon -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Suppress the white flash on cold start -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
