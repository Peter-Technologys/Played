<?xml version="1.0" encoding="utf-8"?>
<!-- Branded splash for API 21+ (Lollipop and above).
     Uses only shapes and vector drawables — no bitmap PNG reference —
     so the resource shrinker cannot corrupt it in release builds. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep dark navy background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF04060D" />
        </shape>
    </item>

    <!-- Subtle cyan glow centred -->
    <item
        android:gravity="center"
        android:width="240dp"
        android:height="240dp">
        <shape android:shape="oval">
            <solid android:color="#1400D4FF" />
        </shape>
    </item>

    <!-- App icon (vector — shrinker-safe) centred -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <drawable android:drawable="@drawable/ic_launcher_foreground" />
    </item>

</layer-list>
