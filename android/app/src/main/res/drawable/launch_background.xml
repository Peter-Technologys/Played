<?xml version="1.0" encoding="utf-8"?>
<!-- Branded splash shown by Android while the Flutter engine loads.
     Uses only shapes/colors — no bitmap reference — so the resource
     shrinker cannot break it regardless of minifyEnabled/shrinkResources. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep dark navy background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF04060D" />
        </shape>
    </item>

    <!-- Subtle cyan glow centred -->
    <item
        android:gravity="center"
        android:width="240dp"
        android:height="240dp">
        <shape android:shape="oval">
            <solid android:color="#1400D4FF" />
        </shape>
    </item>

</layer-list>
