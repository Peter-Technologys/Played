<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 launch window.
  Keep startup quiet: one opaque background + a modest centered OTYA mark.
  Android 12+ uses the platform SplashScreen attributes in values-v31/styles.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF04060D" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="72dp"
        android:height="72dp" />
</layer-list>
