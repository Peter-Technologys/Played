<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Density-specific transparent foreground derived from the current
         approved Otya cyan/blue app mark. The adaptive background remains a
         separate launcher layer so Android can apply its own system mask. -->
    <item>
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:gravity="fill" />
    </item>
</layer-list>