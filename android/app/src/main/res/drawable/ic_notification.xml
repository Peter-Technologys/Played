<?xml version="1.0" encoding="utf-8"?>
<!--
  FCM small-notification icon — must be a monochrome white vector on a
  transparent background (Android notification icon guidelines).
  Size: 24 × 24 dp  |  viewportWidth/Height: 24
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      Play-circle outline:
        • Outer circle ring
        • Filled play triangle
      Both paths use #FFFFFFFF so the icon renders correctly as a
      white silhouette in the status bar and notification shade.
    -->

    <!-- Outer circle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2
            C6.477,2 2,6.477 2,12
            C2,17.523 6.477,22 12,22
            C17.523,22 22,17.523 22,12
            C22,6.477 17.523,2 12,2
            Z
            M12,20
            C7.582,20 4,16.418 4,12
            C4,7.582 7.582,4 12,4
            C16.418,4 20,7.582 20,12
            C20,16.418 16.418,20 12,20
            Z" />

    <!-- Play triangle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,8.5 L16,12 L10,15.5 Z" />

</vector>
